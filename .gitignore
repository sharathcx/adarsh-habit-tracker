# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code skills + plans + dev settings (project-local, not for repo)
.claude/

# local reference images and notes (not for repo)
*.jpeg
*.jpg
!public/**/*.jpeg
!public/**/*.jpg

# study material / uploaded notes (stored in S3/MinIO now, not git)
/notes/
/notes-extracted/
/gate datascience and ai/
/studysessions-backup.json
